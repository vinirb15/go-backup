CRON_TIME=0 0 * * *   # Opcional; formato cron de 5 campos (robfig/cron/v3). Padrão: meia-noite
TZ=America/Sao_Paulo  # Opcional; fuso horário do agendamento (IANA tz). Padrão: fuso do sistema

# Lista de aliases dos bancos. Cada alias lê as variáveis <ALIAS>_DB_* (alias em maiúsculas).
DATABASES=app,crm

APP_DB_TYPE=postgres
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=app
APP_DB_USER=user
APP_DB_PASS=secret-pass

CRM_DB_TYPE=mysql
CRM_DB_HOST=localhost
CRM_DB_PORT=3306
CRM_DB_NAME=crm
CRM_DB_USER=user
CRM_DB_PASS=secret-pass

# Sem DATABASES, vale o formato de banco único:
# DB_TYPE=postgres  # Ou mysql
# DB_HOST=localhost
# DB_PORT=5432      # 3306 para MySQL
# DB_NAME=my-database
# DB_USER=user
# DB_PASS=secret-pass
